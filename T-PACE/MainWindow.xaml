<Window x:Class="T_PACE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDV - Frente de Caixa" MinHeight="600"
        Icon="icone.ico"
        WindowStartupLocation="CenterScreen" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=txtBusca}">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource BgFundo}" Offset="0.0"/>
            <GradientStop Color="{StaticResource Papel}" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- MAIN GRID -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackground}" Padding="30,0" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="0,0,0,2">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.3" BlurRadius="20" ShadowDepth="4"/>
            </Border.Effect>
            <Grid>
                <TextBlock Text="T-PACE  |  PDV" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="22" FontWeight="Black" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#1AC4A574" Padding="12,6" CornerRadius="8" Margin="0,0,20,0" BorderBrush="#44C4A574" BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource OuroManchaBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Caixa Aberto" Foreground="{StaticResource OuroManchaBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Width="35" Height="35" CornerRadius="8" Background="{StaticResource OuroMedioBrush}" Margin="0,0,15,0" BorderBrush="{StaticResource BrancoBrush}" BorderThickness="2">
                        <TextBlock x:Name="txtIniciaisUsuario" Text="US" Foreground="{StaticResource BrancoBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="txtNomeUsuario" Text="Operador" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTEÚDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="30,30,30,20">
            <Grid.ColumnDefinitions>
                <!-- Otimizado para telas de 1360px -->
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- LADO ESQUERDO: CUPOM FISCAL -->
            <Border Grid.Column="0" Background="{StaticResource CardBackground}" Margin="0,0,25,0" Padding="30" CornerRadius="12" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.15" BlurRadius="40" ShadowDepth="12" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Lolla Sorvetes - Carlos Barbosa" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextoPrincipalBrush}" Margin="0,0,0,15"/>

                    <Border Grid.Row="1" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="2" CornerRadius="8" Background="#99FDFCEF" Padding="15,10">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.15" BlurRadius="10" ShadowDepth="3"/>
                        </Border.Effect>
                        <Grid>
                            <TextBlock Text="Digite o código do produto..." FontSize="18" Foreground="{StaticResource TextoPrincipalBrush}" 
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="Medium">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtBusca}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox x:Name="txtBusca" FontSize="22" Padding="15,5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TintaBrush}" VerticalContentAlignment="Center" FontWeight="Bold" TextChanged="txtBusca_TextChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="5,20,5,10" Padding="10,0,10,10" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="0,0,0,1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CÓDIGO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}"/>
                            <TextBlock Grid.Column="1" Text="DESCRIÇÃO" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}"/>
                            <TextBlock Grid.Column="2" Text="QTD" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="V.UN (R$)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="TOTAL (R$)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" TextAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="listaCupom" Grid.Row="3" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Descricao}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TintaBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Quantidade}" Foreground="{StaticResource TintaBrush}" FontSize="16" FontWeight="Black" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PrecoUnitario, StringFormat=R$ {0:N2}}" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat=R$ {0:N2}}" Foreground="{StaticResource TintaBrush}" FontSize="16" FontWeight="Black" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- LADO DIREITO: RESUMO -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" CornerRadius="12" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.15" BlurRadius="40" ShadowDepth="12" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CONTEÚDO SUPERIOR COM A FOTO E TEXTOS -->
                    <Grid Grid.Row="0" Margin="15,10,15,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CAIXA DA FOTO AMPLIADA -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Rectangle Fill="#33E8DCC4" Stroke="{StaticResource OuroClaroBrush}" StrokeThickness="2" StrokeDashArray="4 4" RadiusX="8" RadiusY="8"/>
                            <TextBlock x:Name="txtFotoPlaceholder" Text="FOTO DO PRODUTO" Foreground="{StaticResource TextoClaroBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="imgProdutoFoto" Stretch="Uniform" Margin="0" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <!-- TEXTOS DO ÚLTIMO PRODUTO (COMPACTOS PARA NÃO SOBREPOR) -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                            <TextBlock x:Name="txtUltimoNome" Text=" " FontSize="18" FontWeight="Black" Foreground="{StaticResource TintaBrush}" Margin="0,0,0,2" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock x:Name="txtUltimoDetalhes" Text="Cód: ---  |  Qtd: --" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="txtUltimoPreco" Text="R$ 0,00" FontSize="26" FontWeight="Black" Foreground="{StaticResource PrimariaBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- PAINEL INFERIOR DE TOTAIS -->
                    <Border Grid.Row="1" Background="#CCFDFCEF" Padding="20,15" CornerRadius="0,0,12,12" BorderBrush="#44E8DCC4" BorderThickness="0,1.5,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Subtotal da Venda" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}"/>
                                <TextBlock x:Name="txtSubtotal" Text="R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Descontos Aplicados" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}"/>
                                <TextBlock x:Name="txtDesconto" Text="- R$ 0,00" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border BorderBrush="#44E8DCC4" BorderThickness="0,1.5,0,0" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="TOTAL" FontSize="18" FontWeight="Black" Foreground="{StaticResource TintaBrush}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="txtTotal" Text="R$ 0,00" FontSize="24" FontWeight="Black" Foreground="{StaticResource PrimariaBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Button x:Name="btnFinalizar" Cursor="Hand" BorderThickness="0" Padding="0,12" Background="{StaticResource PrimariaBrush}" Foreground="{StaticResource BrancoBrush}" Style="{StaticResource PrimaryButton}">
                                <Button.Effect>
                                    <DropShadowEffect Color="{StaticResource CorPrimaria}" Opacity="0.3" BlurRadius="15" ShadowDepth="4" Direction="270"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="RECEBER" FontSize="18" FontWeight="Black" Margin="0,0,10,0"/>
                                    <TextBlock Text="[ F2 ]" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- RODAPÉ -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackground}" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="0,1.5,0,0" Padding="8,5">
            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="[ F1 ] Ajuda" Foreground="{StaticResource TextoClaroBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F1_Click"/>
                <TextBlock Text="[ F2 ] Pagamento" Foreground="{StaticResource PrimariaBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F2_Click"/>
                <TextBlock Text="[ F3 ] Vendas Dia" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F3_Click"/>
                <TextBlock Text="[ F4 ] Item Avulso" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F4_Click"/>
                <TextBlock Text="[ F5 ] Buscar Prod." Foreground="{StaticResource TextoPrincipalBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F5_Click"/>
                <TextBlock Text="[ F6 ] Baixa/Crediário" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F6_Click"/>
                <TextBlock Text="[ F7 ] Meu Caixa" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F7_Click"/>
                <TextBlock Text="[ F9 ] Minimizar" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F9_Click"/>
                <TextBlock Text="[ F10 ] Menu" Foreground="{StaticResource TextoClaroBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F10_Click"/>
                <TextBlock Text="[ F11 ] Encerrar" Foreground="#D43D3D" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F11_Click"/>
                <TextBlock Text="[ F12 ] Promoção" Foreground="{StaticResource OuroManchaBrush}" FontSize="12" FontWeight="Bold" Margin="8,2" Cursor="Hand" MouseLeftButtonUp="Rodape_F12_Click"/>
            </WrapPanel>
        </Border>

        <!-- OVERLAY DE CANCELAMENTO (F3) -->
        <Border x:Name="OverlayCancelamento" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="450" Height="250" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CANCELAR ITEM" Foreground="#D43D3D" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Bipe ou digite o código do item a ser cancelado:" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtBuscaCancelamento" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="10,5" Background="#E6F8F5E5" BorderThickness="0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="[ ESC ] Fechar" Foreground="{StaticResource TextoClaroBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY DE BUSCA POR NOME (F4) -->
        <Border x:Name="OverlayBusca" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="700" Height="480" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="BUSCAR PRODUTO" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBox x:Name="txtBuscaNome" Grid.Row="1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="10,8" Background="#E6F8F5E5" BorderThickness="0" Margin="0,0,0,15" TextChanged="txtBuscaNome_TextChanged" PreviewKeyDown="txtBuscaNome_PreviewKeyDown"/>

                    <!-- Lista com rolagem horizontal bloqueada -->
                    <ListBox x:Name="listaResultadosBusca" Grid.Row="2" Background="Transparent" BorderThickness="0" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             KeyDown="listaResultadosBusca_KeyDown" MouseDoubleClick="listaResultadosBusca_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Nome do produto com retículas automáticas se for longo -->
                                        <TextBlock Grid.Column="0" Text="{Binding nome}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding preco_venda, StringFormat=R$ {0:N2}}" FontSize="15" FontWeight="Black" Foreground="{StaticResource PrimariaBrush}" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,15,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding codigo_barras}" FontSize="13" Foreground="{StaticResource TextoClaroBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="[ ↑↓ ] Navegar   [ ENTER ] Selecionar   [ ESC ] Fechar" Foreground="{StaticResource TextoClaroBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY DE DESCONTO GLOBAL (F5) -->
        <Border x:Name="OverlayDesconto" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="400" Height="250" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="APLICAR DESCONTO" Foreground="{StaticResource PrimariaBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Valor (R$) ou Porcentagem (%):" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtValorDesconto" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="10,5" Background="#E6F8F5E5" BorderThickness="0" TextAlignment="Center" PreviewKeyDown="txtValorDesconto_PreviewKeyDown"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="[ ESC ] Cancelar   [ ENTER ] Confirmar" Foreground="{StaticResource TextoClaroBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY DE PAGAMENTO E FINALIZAÇÃO (F2) -->
        <Border x:Name="OverlayPagamento" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="450" Height="420" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="FINALIZAR VENDA" Foreground="{StaticResource PrimariaBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Total a Pagar -->
                    <Grid Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="TOTAL A PAGAR:" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtPagamentoTotal" Text="R$ 0,00" FontSize="28" FontWeight="Black" Foreground="{StaticResource PrimariaBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Método de Pagamento -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Método de Pagamento:" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="cmbMetodoPagamento" FontSize="18" Padding="10,5" SelectedIndex="0" Foreground="{StaticResource TintaBrush}" FontWeight="Bold" Background="{StaticResource BrancoBrush}" BorderBrush="{StaticResource BordaBrush}">
                            <ComboBoxItem Content="dinheiro"/>
                            <ComboBoxItem Content="pix"/>
                            <ComboBoxItem Content="cartão de crédito"/>
                            <ComboBoxItem Content="cartão de débito"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Valor Recebido (para calcular troco) -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="Valor Recebido do Cliente (R$):" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtValorRecebido" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="10,5" Background="#E6F8F5E5" BorderThickness="0" TextAlignment="Right" PreviewKeyDown="txtValorRecebido_PreviewKeyDown" TextChanged="txtValorRecebido_TextChanged"/>
                    </StackPanel>

                    <!-- Troco -->
                    <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,0,0,20">
                        <TextBlock Text="TROCO:" FontSize="18" FontWeight="Bold" Foreground="#D43D3D" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtTroco" Text="R$ 0,00" FontSize="26" FontWeight="Black" Foreground="#D43D3D" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock Grid.Row="5" Text="[ ↑ / ↓ ] Trocar Pagamento   [ ESC ] Voltar   [ ENTER ] Confirmar" Foreground="{StaticResource TextoClaroBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Border>
        <!-- OVERLAY DE FECHAMENTO DE CAIXA (F9) -->
        <Border x:Name="OverlayFechamento" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Width="450" Height="250" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="FECHAR CAIXA" Foreground="#D43D3D" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Valor Final na Gaveta (R$):" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBox x:Name="txtValorFechamento" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="10,5" Background="#E6F8F5E5" BorderThickness="0" TextAlignment="Center" PreviewKeyDown="txtValorFechamento_PreviewKeyDown"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="[ ESC ] Cancelar   [ ENTER ] Confirmar Encerramento" Foreground="{StaticResource TextoClaroBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY AJUDA (F1) -->
