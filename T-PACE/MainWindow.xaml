                                <TextBlock Grid.Row="2" Grid.Column="0" Text="F3" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Vendas do Dia" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="F4" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Add Item (Item Avulso)" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="F5" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Produtos (Buscar produtos)" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="F6" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Baixa (Clientes/Crediário)" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="F7" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Meu Caixa (Controle de caixa)" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="F9" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Minimizar Sistema" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="8" Grid.Column="0" Text="F10" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="Menu Multifunção" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="9" Grid.Column="0" Text="F11" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="Encerrar Sistema" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="10" Grid.Column="0" Text="F12" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="Promoção" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                                <TextBlock Grid.Row="11" Grid.Column="0" Text="ESC" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontFamily="Consolas" FontSize="14"/>
                                <TextBlock Grid.Row="11" Grid.Column="1" Text="Sair / Fechar janela atual" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14"/>
                            </Grid>
                            <TextBlock Text="COMANDOS DE LINHA (Campo de busca)" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="16" Margin="0,20,0,5"/>
