                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="[Código] + Enter" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextoClaroBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Adiciona produto pelo código" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="5*10 ou 5x10" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextoClaroBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Adiciona 5 unidades do produto 10" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="10 azul" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextoClaroBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Complementa descrição do item" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Obs azul" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextoClaroBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Complementa descrição do último item" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Des2,50 ou Des10%" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextoClaroBrush}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Aplica desconto no total da venda" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Novo" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource TextoClaroBrush}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Inicia nova venda (limpa atual)" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="[ ESC ] Fechar" Foreground="{StaticResource TextoClaroBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY VENDAS DO DIA (F3) -->
        <Border x:Name="OverlayVendasDia" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100" KeyDown="OverlayVendasDia_KeyDown" Focusable="True">
            <Border Width="1000" Height="650" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PrimariaBrush}" CornerRadius="12,12,0,0" Padding="25,18">
                        <TextBlock Text="VENDAS DO DIA" Foreground="{StaticResource BrancoBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Content -->
                    <Grid Grid.Row="1" Margin="25,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- Search/Filter bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtVendasDiaBusca" FontSize="16" Foreground="{StaticResource TintaBrush}" Padding="12,10" Background="#FDFCEF" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1" KeyDown="txtVendasDiaBusca_KeyDown"/>
                            <TextBlock Grid.Column="1" Text="[ F5 ] Filtrar" Foreground="{StaticResource TextoClaroBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <!-- List -->
                        <ListBox x:Name="listaVendasDia" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="listaVendasDia_MouseDoubleClick" KeyDown="listaVendasDia_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Margin="0,2,0,2" SnapsToDevicePixels="true">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="true">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E8F5E9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFF8E1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="0,0,0,1" Background="#FAFDFCEF">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding id}" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding id_cupom}" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding data_hora, StringFormat='HH:mm:ss'}" Foreground="{StaticResource TextoClaroBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding total, StringFormat='R$ {0:N2}'}" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalDinheiro, StringFormat='Din: {0:N2}'}" Foreground="#2E7D32" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="5" Text="{Binding TotalCredito, StringFormat='C.Créd: {0:N2}'}" Foreground="#1565C0" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="6" Text="{Binding TotalDebito, StringFormat='C.Déb: {0:N2}'}" Foreground="#00695C" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="7" Text="{Binding TotalPix, StringFormat='Pix: {0:N2}'}" Foreground="#6A1B9A" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="8" Text="{Binding TotalCrediario, StringFormat='Cred: {0:N2}'}" Foreground="#E65100" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="0,0,12,12" Padding="18,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="[ ESC ] Fechar   [ Duplo-clique/Enter ] Ver detalhes   [ F5 ] Filtrar" Foreground="{StaticResource TextoClaroBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- OVERLAY DETALHES DA VENDA (do F3) -->
        <Border x:Name="OverlayDetalhesVenda" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="101" KeyDown="OverlayDetalhesVenda_KeyDown" Focusable="True">
            <Border Width="700" Height="600" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PrimariaBrush}" CornerRadius="12,12,0,0" Padding="25,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DETALHES DA VENDA" Foreground="{StaticResource BrancoBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="txtDetalheVendaCupom" Grid.Column="1" Foreground="{StaticResource OuroClaroBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="25,20">
                        <StackPanel>
                            <!-- Info da venda -->
                            <Border Background="#FFF8F5E5" CornerRadius="8" Padding="18" Margin="0,0,0,15" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="1.5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="DATA/HORA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextoClaroBrush}"/>
                                        <TextBlock x:Name="txtDetalheVendaData" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextoClaroBrush}"/>
                                        <TextBlock x:Name="txtDetalheVendaStatus" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimariaBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                        <TextBlock Text="CUPOM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextoClaroBrush}"/>
                                        <TextBlock x:Name="txtDetalheVendaCupomDetalhe" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Valores -->
                            <Grid Margin="0,15,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#E8F5E9" Padding="15" CornerRadius="8" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SUBTOTAL" FontSize="11" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtDetalheVendaSubtotal" Text="R$ 0,00" FontSize="16" FontWeight="Black" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#FFF3E0" Padding="15" CornerRadius="8" Margin="8,0">
                                    <StackPanel>
                                        <TextBlock Text="DESCONTO" FontSize="11" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtDetalheVendaDesconto" Text="R$ 0,00" FontSize="16" FontWeight="Black" Foreground="#E65100" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#E3F2FD" Padding="15" CornerRadius="8" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL" FontSize="11" FontWeight="Bold" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtDetalheVendaTotal" Text="R$ 0,00" FontSize="20" FontWeight="Black" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Itens -->
                            <TextBlock Text="ITENS DA VENDA" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14" Margin="0,20,0,10"/>
                            <ListBox x:Name="listaDetalheItens" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="0,0,0,1" Background="#FAFDFCEF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding nome}" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding quantidade, StringFormat='{} {0} un'}" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding preco_unitario, StringFormat='R$ {0:N2}'}" Foreground="{StaticResource PrimariaBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding subtotal, StringFormat='R$ {0:N2}'}" Foreground="{StaticResource PrimariaBrush}" FontWeight="Black" FontSize="13" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- Pagamentos -->
                            <TextBlock Text="PAGAMENTOS" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="14" Margin="0,20,0,10"/>
                            <ListBox x:Name="listaDetalhePagamentos" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Background="#E8F5E9" CornerRadius="6" Margin="0,0,0,5" BorderBrush="#2E7D32" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding metodo}" FontWeight="Bold" Foreground="#2E7D32" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding valor, StringFormat='R$ {0:N2}'}" FontWeight="Black" Foreground="#2E7D32" FontSize="13" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- Footer -->
                    <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="0,0,12,12" Padding="18,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="[ ESC ] Voltar" Foreground="{StaticResource TextoClaroBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <Button Content="FECHAR" Style="{StaticResource SecondaryButton}" FontSize="13" FontWeight="Bold" Padding="24,10" Click="FecharDetalhesVenda_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

<!-- OVERLAY ITEM AVULSO (F4) -->
        <Border x:Name="OverlayItemAvulso" Grid.RowSpan="3" Background="#B21E1915" Visibility="Collapsed" Panel.ZIndex="100" KeyDown="OverlayItemAvulso_KeyDown" Focusable="True">
            <Border Width="520" Height="580" Background="{StaticResource CardBackground}" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource Tinta}" Opacity="0.6" BlurRadius="40" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PrimariaBrush}" CornerRadius="12,12,0,0" Padding="25,18">
                        <TextBlock Text="ITEM AVULSO" Foreground="{StaticResource BrancoBrush}" FontSize="22" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,20">
                        <StackPanel>
                            <TextBlock Text="Descrição *" Foreground="{StaticResource TextoPrincipalBrush}" FontWeight="SemiBold" Margin="0,0,0,6" FontSize="14"/>
                            <TextBox x:Name="txtItemAvulsoDesc" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="12,10" Background="#FDFCEF" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1" PreviewKeyDown="txtItemAvulso_PreviewKeyDown"/>
                            <TextBlock Text="Complemento" Foreground="{StaticResource TextoPrincipalBrush}" FontWeight="SemiBold" Margin="0,18,0,6" FontSize="14"/>
                            <TextBox x:Name="txtItemAvulsoComp" FontSize="16" Foreground="{StaticResource TintaBrush}" Padding="12,10" Background="#FDFCEF" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1" PreviewKeyDown="txtItemAvulso_PreviewKeyDown"/>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Quantidade" Foreground="{StaticResource TextoPrincipalBrush}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBox x:Name="txtItemAvulsoQtd" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="12,10" Background="#FDFCEF" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1" Text="1" TextAlignment="Center" TextChanged="txtItemAvulso_TextChanged" PreviewKeyDown="txtItemAvulso_PreviewKeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Preço Unitário (R$)" Foreground="{StaticResource TextoPrincipalBrush}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBox x:Name="txtItemAvulsoPreco" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TintaBrush}" Padding="12,10" Background="#FDFCEF" BorderBrush="{StaticResource BordaBrush}" BorderThickness="1" TextAlignment="Right" TextChanged="txtItemAvulso_TextChanged" PreviewKeyDown="txtItemAvulso_PreviewKeyDown"/>
                                </StackPanel>
                            </Grid>
                            <Border Margin="0,20,0,0" Padding="18" Background="#FFF8F5E5" CornerRadius="8" BorderBrush="{StaticResource OuroClaroBrush}" BorderThickness="1.5">
